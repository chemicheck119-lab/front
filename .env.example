# 브라우저가 호출할 서비스 BE/BFF 주소입니다. 모델 API 주소나 API Key를 넣지 마세요.
VITE_BFF_BASE_URL=http://localhost:8080

# 운영 지도 사업자 또는 자체 호스팅 MapLibre Style URL입니다.
# 설정 전에는 잘못된 지도를 대신 표시하지 않고 "지도 스타일 연결 필요" 상태를 표시합니다.
VITE_MAP_STYLE_URL=
VITE_MAP_DARK_STYLE_URL=
# 저장소에는 넣지 않습니다. 도메인 제한된 브라우저용 공개 키만 환경별 로컬/배포 설정으로 주입합니다.
VITE_MAP_PUBLIC_TOKEN=

# 현재 공모전 staging은 인증을 사용하지 않습니다. 인증 도입 시에만 true와 신뢰된 로그인 URL을 함께 설정합니다.
VITE_ENABLE_AUTH=false
VITE_DEFAULT_STATION_NAME=현장대응본부
VITE_AUTH_LOGIN_URL=

# 임시 운영 설정입니다. 실제 운영에서는 인증된 로그인 세션/BFF 응답으로 제공하는 것을 권장합니다.
VITE_DISPATCH_CENTER_NAME=
VITE_DISPATCH_CENTER_PHONE=

# BE의 모델 응답 제한(15초)보다 길어야 구조화된 MODEL_TIMEOUT 응답을 받을 수 있습니다.
VITE_API_TIMEOUT_MS=20000
VITE_LOCATION_UPDATE_INTERVAL_MS=5000

# 발표용 fixture를 사용할 때만 true. 운영에서는 반드시 false입니다.
VITE_ENABLE_DEMO_MODE=false

# BE 구현·배포가 확인된 환경에서만 활성화
VITE_ENABLE_MOVEMENT_API=false
VITE_ENABLE_RECORD_API=false
