# 브라우저가 호출할 서비스 BE/BFF 주소입니다. 모델 API 주소나 API Key를 넣지 마세요.
VITE_BFF_BASE_URL=http://localhost:8080

# 운영 지도 사업자 또는 자체 호스팅 MapLibre Style URL입니다.
VITE_MAP_STYLE_URL=https://example.com/styles/chemicheck-light/style.json
VITE_MAP_DARK_STYLE_URL=https://example.com/styles/chemicheck-dark/style.json

VITE_API_TIMEOUT_MS=10000
VITE_LOCATION_UPDATE_INTERVAL_MS=5000

# 발표용 fixture를 사용할 때만 true. 운영에서는 반드시 false입니다.
VITE_ENABLE_DEMO_MODE=false
