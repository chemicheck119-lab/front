# BE develop@d1a7391 기반 staging BFF입니다. VITE_* 값은 브라우저 번들에 공개됩니다.
VITE_BFF_BASE_URL=https://chemicheck119-be-staging-w6s6lwanpa-du.a.run.app
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_PRESENTATION_SCENARIO=true
VITE_ENABLE_AUTH=false
VITE_DEFAULT_STATION_NAME=현장대응본부
VITE_ENABLE_MOVEMENT_API=false
VITE_ENABLE_RECORD_API=false

# 현재 staging은 로그인·세션 UI를 사용하지 않고 현장 화면으로 바로 진입합니다.
VITE_AUTH_LOGIN_URL=

# 실제 도로·건물·지명이 보이는 MapTiler Streets를 운영 배경지도로 사용합니다.
# 도메인 제한 공개 키는 VITE_MAP_PUBLIC_TOKEN으로 빌드 시 주입하며 이 파일에 저장하지 않습니다.
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json
VITE_MAP_DARK_STYLE_URL=https://api.maptiler.com/maps/streets-v2-dark/style.json
