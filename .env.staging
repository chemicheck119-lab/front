# Firebase Hosting이 /api, /auth를 Cloud Run BFF로 같은 출처 프록시합니다.
# VITE_* 값은 브라우저 번들에 공개되므로 비밀 값은 넣지 않습니다.
VITE_BFF_BASE_URL=https://chemicheck119.site
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_PRESENTATION_SCENARIO=false
VITE_ENABLE_AUTH=true
VITE_DEFAULT_STATION_NAME=
VITE_ENABLE_MOVEMENT_API=true
VITE_ENABLE_RECORD_API=true

# 공개 파일럿 버튼이 HttpOnly 서명 세션을 발급받습니다. 실제 기관 인증 경로와 구분합니다.
VITE_AUTH_LOGIN_URL=https://chemicheck119.site/auth/staging/pilot

# 실제 도로·건물·지명이 보이는 MapTiler Streets를 운영 배경지도로 사용합니다.
# 도메인 제한 공개 키는 VITE_MAP_PUBLIC_TOKEN으로 빌드 시 주입하며 이 파일에 저장하지 않습니다.
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json
VITE_MAP_DARK_STYLE_URL=https://api.maptiler.com/maps/streets-v2-dark/style.json
# 설정되면 네이버 Web Dynamic Map을 우선 사용하고 MapTiler는 fallback으로 유지합니다.
# 도메인 제한 Client ID는 저장소 밖의 VITE_NAVER_MAP_CLIENT_ID로 빌드 시 주입합니다.
